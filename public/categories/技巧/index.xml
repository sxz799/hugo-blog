    <item>
      <title>常用sql语句记录</title>
      <link>http://localhost:1313/posts/%E6%8A%80%E5%B7%A7/2022-09-22-%E5%B8%B8%E7%94%A8sql%E8%AF%AD%E5%8F%A5%E8%AE%B0%E5%BD%95/</link>
      <pubDate>Thu, 22 Sep 2022 22:11:09 +0000</pubDate>
      <guid>http://localhost:1313/posts/%E6%8A%80%E5%B7%A7/2022-09-22-%E5%B8%B8%E7%94%A8sql%E8%AF%AD%E5%8F%A5%E8%AE%B0%E5%BD%95/</guid>
      <description>&lt;ul&gt;
&lt;li&gt;批量修改A表中数据在B表中的映射数据&lt;/li&gt;
&lt;/ul&gt;
&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;UPDATE tableA a LEFT JOIN tableB b on a.Aid=b.Bid set a.codeA=b.codeB
&lt;/code&gt;&lt;/pre&gt;&lt;p&gt;在oracle中语句如下&lt;/p&gt;
&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;UPDATE tableA
SET tableA.codeA = (
  SELECT tableB.codeB
  FROM tableB
  WHERE tableA.Aid = tableB.Bid
);
&lt;/code&gt;&lt;/pre&gt;&lt;ul&gt;
&lt;li&gt;mybatis操作oracle时批量foreach执行语句&lt;/li&gt;
&lt;/ul&gt;
&lt;h3 id=&#34;mysql&#34;&gt;mysql&lt;/h3&gt;
&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;
&amp;lt;update id=&amp;#34;batchUpdateXXX&amp;#34; parameterType=&amp;#34;java.util.List&amp;#34;&amp;gt;
        &amp;lt;foreach collection=&amp;#34;list&amp;#34; item=&amp;#34;item&amp;#34; index=&amp;#34;index&amp;#34; separator=&amp;#34;;&amp;#34;&amp;gt;
            update YOUR_TABLE set COL1 = #{item.COL1},COL2 = #{item.COL2} where id = #{item.id}
        &amp;lt;/foreach&amp;gt;
&amp;lt;/update&amp;gt;
&lt;/code&gt;&lt;/pre&gt;&lt;h3 id=&#34;oracle&#34;&gt;oracle&lt;/h3&gt;
&lt;pre tabindex=&#34;0&#34;&gt;&lt;code&gt;
&amp;lt;update id=&amp;#34;batchUpdateXXX&amp;#34; parameterType=&amp;#34;java.util.List&amp;#34;&amp;gt;
        &amp;lt;foreach collection=&amp;#34;list&amp;#34; item=&amp;#34;item&amp;#34; index=&amp;#34;index&amp;#34; open=&amp;#34;BEGIN&amp;#34; close=&amp;#34;;end;&amp;#34; separator=&amp;#34;;&amp;#34;&amp;gt;
            update YOUR_TABLE set COL1 = #{item.COL1},COL2 = #{item.COL2} where id = #{item.id}
        &amp;lt;/foreach&amp;gt;
&amp;lt;/update&amp;gt;
&lt;/code&gt;&lt;/pre&gt;</description>
    </item>
